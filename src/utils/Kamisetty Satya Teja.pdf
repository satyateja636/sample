<</Author(LTM_CV_AUTHOR)/CreationDate(D:20260804125946+05'00')/Creator((unspecified))/Keywords()/ModDate(D:20260904160434+05'30')/Producer(ReportLab PDF Library - (opensource))/Subject({"additional": [], "exclude": ["certifications", "visa", "work_experience_onsite"], "name": "Kamisetty Satya Teja\\u00a0", "email_id": "satyateja636@gmail.com", "contact": "9440533759", "location": "Hyderbad , India", "designation": "Backend Developer", "img": "", "summary": ["Leverage 5.5 years of experience as a Backend Developer specializing in Java, Spring Boot, RESTful microservices, and Apache Kafka.", "Developed and maintained scalable backend systems, optimizing performance and reliability for enterprise-grade applications.", "Implemented RESTful microservices architecture, improving modularity and facilitating seamless integration with front-end and third-party services.", "Enhanced application performance and ensured timely project delivery through effective collaboration and technical expertise."], "skills": [{"category": "Domain", "items": []}, {"category": "Market Trending", "items": [{"skill_name": "Apache Kafka", "category": "Market Trending", "subskills": [{"name": "Kafka Producer API", "competency": "must-have", "selected": true}, {"name": "Kafka Consumer API", "competency": "must-have", "selected": true}, {"name": "Kafka Streams API", "competency": "good-to-have", "selected": false}, {"name": "Kafka Connect", "competency": "good-to-have", "selected": false}, {"name": "Kafka Topics", "competency": "must-have", "selected": true}, {"name": "Kafka Partitions", "competency": "must-have", "selected": true}]}]}, {"category": "Cloud Platform", "items": []}, {"category": "DEV-Ops", "items": [{"skill_name": "Docker", "category": "DEV-Ops", "subskills": [{"name": "Docker Compose", "competency": "must-have", "selected": true}, {"name": "Dockerfile", "competency": "must-have", "selected": true}, {"name": "Docker Swarm", "competency": "good-to-have", "selected": false}, {"name": "Docker Volumes", "competency": "must-have", "selected": true}, {"name": "Docker Networking", "competency": "must-have", "selected": true}]}, {"skill_name": "Kubernetes", "category": "DEV-Ops", "subskills": [{"name": "Kubernetes Pods", "competency": "must-have", "selected": true}, {"name": "Kubernetes Deployments", "competency": "must-have", "selected": true}, {"name": "Kubernetes Services", "competency": "must-have", "selected": true}, {"name": "Kubernetes ConfigMaps", "competency": "must-have", "selected": true}, {"name": "Kubernetes Secrets", "competency": "must-have", "selected": true}, {"name": "Kubernetes Ingress", "competency": "good-to-have", "selected": false}, {"name": "Helm Charts", "competency": "good-to-have", "selected": false}]}, {"skill_name": "GitLab CI/CD", "category": "DEV-Ops", "subskills": [{"name": ".gitlab-ci.yml", "competency": "must-have", "selected": true}, {"name": "GitLab Runners", "competency": "must-have", "selected": true}, {"name": "GitLab Pipelines", "competency": "must-have", "selected": true}, {"name": "GitLab Environments", "competency": "good-to-have", "selected": false}, {"name": "GitLab Artifacts", "competency": "good-to-have", "selected": false}]}]}, {"category": "Scrum Tools", "items": []}, {"category": "Testing Frameworks", "items": [{"skill_name": "JUnit 5", "category": "Testing Frameworks", "subskills": [{"name": "JUnit Jupiter", "competency": "must-have", "selected": true}, {"name": "JUnit Vintage", "competency": "good-to-have", "selected": false}, {"name": "JUnit Platform", "competency": "must-have", "selected": true}, {"name": "JUnit Assertions", "competency": "must-have", "selected": true}, {"name": "JUnit Parameterized Tests", "competency": "good-to-have", "selected": false}]}, {"skill_name": "Mockito", "category": "Testing Frameworks", "subskills": [{"name": "Mockito Annotations", "competency": "must-have", "selected": true}, {"name": "Mockito ArgumentCaptor", "competency": "good-to-have", "selected": false}, {"name": "Mockito Spies", "competency": "good-to-have", "selected": false}, {"name": "Mockito Mocks", "competency": "must-have", "selected": true}, {"name": "Mockito Inline Mocking", "competency": "good-to-have", "selected": false}]}, {"skill_name": "JMeter", "category": "Testing Frameworks", "subskills": [{"name": "JMeter Test Plan", "competency": "must-have", "selected": true}, {"name": "JMeter Thread Groups", "competency": "must-have", "selected": true}, {"name": "JMeter Samplers", "competency": "must-have", "selected": true}, {"name": "JMeter Listeners", "competency": "must-have", "selected": true}, {"name": "JMeter Assertions", "competency": "good-to-have", "selected": false}, {"name": "JMeter Timers", "competency": "good-to-have", "selected": false}]}]}, {"category": "Programming Languages", "items": [{"skill_name": "Java", "category": "Programming Languages", "subskills": [{"name": "Java Collections Framework", "competency": "must-have", "selected": true}, {"name": "Java Streams API", "competency": "must-have", "selected": true}, {"name": "Java Concurrency Utilities", "competency": "must-have", "selected": true}, {"name": "Java Memory Management", "competency": "must-have", "selected": true}, {"name": "Java Reflection API", "competency": "good-to-have", "selected": false}, {"name": "Java Native Interface (JNI)", "competency": "good-to-have", "selected": false}, {"name": "Java Annotations", "competency": "must-have", "selected": true}, {"name": "Java I/O Streams", "competency": "must-have", "selected": true}, {"name": "Java Generics", "competency": "must-have", "selected": true}]}]}, {"category": "Frameworks", "items": [{"skill_name": "Spring", "category": "Frameworks", "subskills": [{"name": "Spring Core Container", "competency": "must-have", "selected": true}, {"name": "Spring Beans", "competency": "must-have", "selected": true}, {"name": "Spring AOP (Aspect-Oriented Programming)", "competency": "must-have", "selected": true}, {"name": "Spring Expression Language (SpEL)", "competency": "good-to-have", "selected": false}, {"name": "Spring Events", "competency": "good-to-have", "selected": false}]}, {"skill_name": "Spring Boot", "category": "Frameworks", "subskills": [{"name": "Spring Boot Auto-Configuration", "competency": "must-have", "selected": true}, {"name": "Spring Boot Starters", "competency": "must-have", "selected": true}, {"name": "Spring Boot Actuator", "competency": "must-have", "selected": true}, {"name": "Spring Boot CLI", "competency": "good-to-have", "selected": false}, {"name": "Spring Boot DevTools", "competency": "good-to-have", "selected": false}]}, {"skill_name": "Spring Data JPA", "category": "Frameworks", "subskills": [{"name": "JpaRepository", "competency": "must-have", "selected": true}, {"name": "CrudRepository", "competency": "must-have", "selected": true}, {"name": "PagingAndSortingRepository", "competency": "good-to-have", "selected": false}, {"name": "Query Methods", "competency": "must-have", "selected": true}, {"name": "@Query Annotation", "competency": "must-have", "selected": true}, {"name": "EntityManager Integration", "competency": "good-to-have", "selected": false}]}, {"skill_name": "Spring JDBC", "category": "Frameworks", "subskills": [{"name": "JdbcTemplate", "competency": "must-have", "selected": true}, {"name": "NamedParameterJdbcTemplate", "competency": "good-to-have", "selected": false}, {"name": "SimpleJdbcInsert", "competency": "good-to-have", "selected": false}, {"name": "SimpleJdbcCall", "competency": "good-to-have", "selected": false}]}, {"skill_name": "Spring Security", "category": "Frameworks", "subskills": [{"name": "Spring Security OAuth2", "competency": "good-to-have", "selected": false}, {"name": "Spring Security JWT", "competency": "good-to-have", "selected": false}, {"name": "Spring Security LDAP", "competency": "good-to-have", "selected": false}, {"name": "Spring Security SAML", "competency": "good-to-have", "selected": false}, {"name": "Spring Security Web", "competency": "must-have", "selected": true}, {"name": "Spring Security Method Security", "competency": "must-have", "selected": true}]}, {"skill_name": "Spring MVC", "category": "Frameworks", "subskills": [{"name": "DispatcherServlet", "competency": "must-have", "selected": true}, {"name": "HandlerMapping", "competency": "must-have", "selected": true}, {"name": "ViewResolver", "competency": "must-have", "selected": true}, {"name": "ModelAndView", "competency": "must-have", "selected": true}, {"name": "@Controller Annotation", "competency": "must-have", "selected": true}, {"name": "@RestController Annotation", "competency": "must-have", "selected": true}]}, {"skill_name": "RESTful Web Services", "category": "Frameworks", "subskills": [{"name": "OpenAPI (Swagger)", "competency": "good-to-have", "selected": false}, {"name": "HATEOAS", "competency": "good-to-have", "selected": false}, {"name": "JSON Web Token (JWT)", "competency": "good-to-have", "selected": false}, {"name": "Spring REST Controllers", "competency": "must-have", "selected": true}, {"name": "JAX-RS", "competency": "good-to-have", "selected": false}]}]}, {"category": "Databases", "items": [{"skill_name": "Microsoft SQL Server", "category": "Databases", "subskills": [{"name": "T-SQL", "competency": "must-have", "selected": true}, {"name": "SQL Server Management Studio (SSMS)", "competency": "must-have", "selected": true}, {"name": "SQL Server Agent", "competency": "good-to-have", "selected": false}, {"name": "SQL Server Integration Services (SSIS)", "competency": "good-to-have", "selected": false}, {"name": "SQL Server Reporting Services (SSRS)", "competency": "good-to-have", "selected": false}]}, {"skill_name": "MySQL", "category": "Databases", "subskills": [{"name": "MySQL Workbench", "competency": "must-have", "selected": true}, {"name": "InnoDB Storage Engine", "competency": "must-have", "selected": true}, {"name": "MyISAM Storage Engine", "competency": "good-to-have", "selected": false}, {"name": "MySQL Replication", "competency": "good-to-have", "selected": false}, {"name": "MySQL Stored Procedures", "competency": "good-to-have", "selected": false}]}]}], "work_experiences": [{"company_name": "Concentrix Catalyst", "position": "Microservice Developer (Client: TPMG)", "start_date": "Dec 2020", "end_date": "May 2026", "responsibilities": ["Developed and maintained Spring Boot microservices and secure REST APIs for communication, seminar, and webinar features.", "Owned backend logic throughout the SDLC, including requirement analysis, architecture design, and sprint delivery.", "Created web services to aggregate live clinician records from multiple backend systems.", "Developed Kafka producer and consumer applications for asynchronous message processing of high event volumes.", "Designed data persistence layers with Spring JDBC; rewrote and optimized complex SQL queries for improved performance.", "Built unit tests with JUnit 5 and Mockito, increasing coverage and reducing regression defects.", "Conducted stress and endurance testing of APIs using JMeter.", "Utilized Splunk for monitoring and assessing production issues.", "Implemented logging with Logback/log4j for error tracking and log management.", "Tested web services using Postman."], "is_onsite": false}], "projects": [{"project_name": "Video Visits", "project_description": ["Video Visits is an application enabling communication between clinicians and patients.", "Offers separate interfaces for clinicians and patients.", "Clinicians interact via the VV provider application.", "Patients use the member app for communication."], "organization": "Concentrix Catalyst (Client: TPMG)", "role": "Microservice Developer", "technology_stack": "Java/J2EE, Spring Boot, Spring, Kafka, Junit, Tomcat, Eclipse,Spring Tool Suite(STS), Splunk, Maven, Github, Postman, Dbeaver, Sql, Jmeter, docker, Kubernetes", "team_size": null, "start_date": "Jan 2021", "end_date": "Jul 2023"}, {"project_name": "Clinician Connect", "project_description": ["Developed the CC (Clinician Connect) App for Kaiser Permanente to support mobile access to clinician data.", "Integrated multiple backend services for secure, real-time clinician information and availability schedules.", "Enabled clinicians to quickly access data on other clinicians and care teams.", "Deployed the app for internal use within Kaiser Permanente's network."], "organization": "Concentrix Catalyst (Client: TPMG)", "role": "Microservice Developer", "technology_stack": "Java, Spring Boot, Spring, Kafka, Junit, Tomcat, Eclipse,Spring Tool Suite(STS), Splunk, Maven, Github, Postman, Dbeaver , Sql, Jmeter, docker, Kubernetes.", "team_size": "", "start_date": "Aug 2023", "end_date": "May 2026"}], "education": [{"degree": "Bachelor of Technology", "institution": "SRM Institute of Science and Technology, Chennai, India", "year_of_passing": "2020"}], "certifications": [], "visas": [], "work_experiences_onsite": []})/Title((anonymous))/Trapped/False>>
